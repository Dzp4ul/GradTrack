        <mxCell id="p7-normalize" value="Normalize submitted input" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D9EAF7;strokeColor=#2F75B5;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontColor=#1F2937;" vertex="1" parent="p7-1"><mxGeometry x="775" y="285" width="250" height="60" as="geometry"/></mxCell>
        <mxCell id="p7-select" value="Select next question" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D9EAF7;strokeColor=#2F75B5;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontColor=#1F2937;" vertex="1" parent="p7-1"><mxGeometry x="775" y="385" width="250" height="60" as="geometry"/></mxCell>
