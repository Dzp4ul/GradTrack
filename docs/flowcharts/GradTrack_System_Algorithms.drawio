        <mxCell id="p7-start" value="Start" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#E2F0D9;strokeColor=#548235;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="p7-1"><mxGeometry x="820" y="90" width="160" height="55" as="geometry"/></mxCell>
