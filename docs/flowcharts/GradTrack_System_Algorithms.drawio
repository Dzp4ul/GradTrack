  <diagram id="gradtrack-sha256" name="06 - SHA-256 Reset Token">
    <mxGraphModel dx="1800" dy="1450" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1450" math="0" shadow="0">
      <root>
        <mxCell id="p6-0"/>
        <mxCell id="p6-1" parent="p6-0"/>
        <mxCell id="p6-title" value="SHA-256 Password-Reset Token Hashing Algorithm" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=20;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="p6-1"><mxGeometry x="300" y="20" width="1200" height="35" as="geometry"/></mxCell>
        <mxCell id="p6-subtitle" value="GradTrack — Norzagaray College" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#4B5563;" vertex="1" parent="p6-1"><mxGeometry x="700" y="55" width="400" height="25" as="geometry"/></mxCell>
        <mxCell id="p6-token-phase" value="RESET TOKEN ISSUANCE — SHA-256 protects the token" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#2F75B5;" vertex="1" parent="p6-1"><mxGeometry x="270" y="90" width="520" height="25" as="geometry"/></mxCell>
        <mxCell id="p6-password-phase" value="PASSWORD UPDATE — bcrypt protects the password" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#548235;" vertex="1" parent="p6-1"><mxGeometry x="1100" y="650" width="520" height="25" as="geometry"/></mxCell>
        <mxCell id="p6-start" value="Start" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#E2F0D9;strokeColor=#548235;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="p6-1"><mxGeometry x="450" y="130" width="160" height="55" as="geometry"/></mxCell>
        <mxCell id="p6-otp" value="OTP verified?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF9000;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="p6-1"><mxGeometry x="430" y="225" width="200" height="90" as="geometry"/></mxCell>
        <mxCell id="p6-reject" value="Reject reset request" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#FCE8E6;strokeColor=#C5221F;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontColor=#7F1D1D;" vertex="1" parent="p6-1"><mxGeometry x="70" y="240" width="230" height="60" as="geometry"/></mxCell>
        <mxCell id="p6-reject-end" value="End" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#FCE8E6;strokeColor=#C5221F;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#7F1D1D;" vertex="1" parent="p6-1"><mxGeometry x="105" y="340" width="160" height="55" as="geometry"/></mxCell>
        <mxCell id="p6-random" value="Generate 32 random bytes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D9EAF7;strokeColor=#2F75B5;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontColor=#1F2937;" vertex="1" parent="p6-1"><mxGeometry x="405" y="355" width="250" height="60" as="geometry"/></mxCell>
        <mxCell id="p6-hex" value="Hex-encode reset token" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D9EAF7;strokeColor=#2F75B5;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontColor=#1F2937;" vertex="1" parent="p6-1"><mxGeometry x="405" y="455" width="250" height="60" as="geometry"/></mxCell>
        <mxCell id="p6-sha" value="Compute SHA-256 token digest" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF9000;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="p6-1"><mxGeometry x="405" y="555" width="250" height="60" as="geometry"/></mxCell>
        <mxCell id="p6-store" value="Store digest with 15-minute expiration" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#E8F1FB;strokeColor=#2F75B5;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontColor=#1F2937;" vertex="1" parent="p6-1"><mxGeometry x="395" y="655" width="270" height="70" as="geometry"/></mxCell>
        <mxCell id="p6-raw" value="Return raw token to verified client" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#6F42C1;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontColor=#1F2937;" vertex="1" parent="p6-1"><mxGeometry x="390" y="765" width="280" height="65" as="geometry"/></mxCell>
        <mxCell id="p6-receive" value="Receive token and new password" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#6F42C1;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontColor=#1F2937;" vertex="1" parent="p6-1"><mxGeometry x="1170" y="765" width="280" height="65" as="geometry"/></mxCell>
        <mxCell id="p6-validate" value="Validate password and hash submitted token" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D9EAF7;strokeColor=#2F75B5;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontColor=#1F2937;" vertex="1" parent="p6-1"><mxGeometry x="1170" y="870" width="280" height="65" as="geometry"/></mxCell>
        <mxCell id="p6-match" value="Matching verified, unexpired, unused digest?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF9000;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="p6-1"><mxGeometry x="1190" y="975" width="240" height="105" as="geometry"/></mxCell>
        <mxCell id="p6-invalid" value="Return invalid or expired reset error" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#FCE8E6;strokeColor=#C5221F;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontColor=#7F1D1D;" vertex="1" parent="p6-1"><mxGeometry x="850" y="995" width="270" height="65" as="geometry"/></mxCell>
        <mxCell id="p6-invalid-end" value="End" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#FCE8E6;strokeColor=#C5221F;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#7F1D1D;" vertex="1" parent="p6-1"><mxGeometry x="905" y="1100" width="160" height="55" as="geometry"/></mxCell>
        <mxCell id="p6-bcrypt" value="Hash new PASSWORD with bcrypt" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D9EAD3;strokeColor=#548235;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="p6-1"><mxGeometry x="1510" y="995" width="260" height="65" as="geometry"/></mxCell>
        <mxCell id="p6-update" value="Update password" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#E8F1FB;strokeColor=#2F75B5;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontColor=#1F2937;" vertex="1" parent="p6-1"><mxGeometry x="1520" y="1100" width="240" height="65" as="geometry"/></mxCell>
        <mxCell id="p6-used" value="Mark reset record used" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D9EAF7;strokeColor=#2F75B5;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontColor=#1F2937;" vertex="1" parent="p6-1"><mxGeometry x="1520" y="1205" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="p6-success" value="Return success" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#6F42C1;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontColor=#1F2937;" vertex="1" parent="p6-1"><mxGeometry x="1520" y="1305" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="p6-end" value="End" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#E2F0D9;strokeColor=#548235;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="p6-1"><mxGeometry x="1560" y="1385" width="160" height="55" as="geometry"/></mxCell>
        <mxCell id="p6-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="p6-1" source="p6-start" target="p6-otp"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p6-e2" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="p6-1" source="p6-otp" target="p6-reject"><mxGeometry relative="1" as="geometry"/></mxCell>
