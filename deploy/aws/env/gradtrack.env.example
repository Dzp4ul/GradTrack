APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Manila
DB_TIMEZONE=+08:00

DB_HOST=replace-with-rds-endpoint
DB_PORT=3306
DB_NAME=gradtrack
DB_USER=gradtrack_runtime
DB_PASSWORD=replace-with-runtime-password
DB_SSL_CA=/etc/ssl/certs/global-bundle.pem

STORAGE_DRIVER=s3
AWS_REGION=ap-southeast-1
S3_BUCKET=nc-gradtrack-prod
S3_PRESIGNED_URL_TTL_SECONDS=600
# S3_KMS_KEY_ID=replace-only-if-using-a-customer-managed-kms-key

FRONTEND_URL=https://grad-track.app
CORS_ALLOWED_ORIGINS=https://grad-track.app
GRADTRACK_API_BASE_URL=http://127.0.0.1/backend
REALTIME_AUTH_CHECK_URL=http://127.0.0.1/backend/api/graduate-auth/check.php
REALTIME_HOST=127.0.0.1
REALTIME_PORT=3001
REALTIME_AUTO_MIGRATE=false
CHAT_AUTO_MIGRATE=false
SCHEMA_AUTO_MIGRATE=false

SESSION_COOKIE_NAME=GRADTRACKSESSID
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_PATH=/
UPLOAD_REQUEST_MAX_MB=256
LOGIN_THROTTLE_DIR=/var/lib/gradtrack/login-throttle

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=replace-with-mailbox
MAIL_PASSWORD=replace-with-mail-secret
MAIL_FROM_ADDRESS=replace-with-sender
MAIL_FROM_NAME=GRADTRACK
GROQ_API_KEY=replace-with-ai-provider-secret

SURVEY_REMINDER_INTERVAL_DAYS=3
SURVEY_REMINDER_BATCH_LIMIT=100
PSGC_API_BASE_URL=https://psgc.cloud/api/v2
PSGC_CACHE_DIR=/var/lib/gradtrack/psgc-cache
