[Unit]
Description=GradTrack survey deadline and target completion enforcement
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/var/www/gradtrack
EnvironmentFile=/etc/gradtrack/gradtrack.env
ExecStart=/usr/bin/php /var/www/gradtrack/backend/scripts/complete_surveys.php
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
