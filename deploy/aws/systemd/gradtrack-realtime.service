[Unit]
Description=GradTrack Socket.IO realtime service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gradtrack
Group=www-data
WorkingDirectory=/var/www/gradtrack
EnvironmentFile=/etc/gradtrack/gradtrack.env
ExecStart=/usr/bin/node /var/www/gradtrack/backend/realtime/socket-server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
