# Database Configuration
# DB_HOST must be the Amazon RDS endpoint hostname only.
# Do not include http://, https://, or :3306 in DB_HOST.
DB_HOST=your-rds-endpoint.rds.amazonaws.com
DB_NAME=your_database_name
DB_USER=your_username
DB_PASSWORD=your_password
DB_PORT=3306
# Production requires the AWS RDS CA bundle and verifies the server certificate.
# DB_SSL_CA=/etc/ssl/certs/global-bundle.pem
# Optional aliases also supported by the backend:
# DB_DATABASE=your_database_name
# DB_USERNAME=your_username

# Application Configuration
APP_ENV=development
APP_DEBUG=false

# File Storage
# Bucket names are environment-specific configuration, not application code.
# Production must use the EC2 instance role/default credential chain (no static keys/profile).
STORAGE_DRIVER=local
AWS_REGION=ap-southeast-1
# AWS_DEFAULT_REGION=ap-southeast-1
S3_BUCKET=replace-with-private-bucket-name
# AWS_S3_BUCKET=replace-with-private-bucket-name
S3_PRESIGNED_URL_TTL_SECONDS=600
# Optional for local AWS SSO/shared-credentials authentication.
# AWS_PROFILE=your_gradtrack_development_profile
# Recommended when the named profile is defined in ~/.aws/config (including SSO profiles).
# AWS_SDK_LOAD_NONDEFAULT_CONFIG=1
# Local XAMPP only: avoid probing EC2 instance metadata when no profile/key is configured.
# AWS_EC2_METADATA_DISABLED=true
# Alternative for a local IAM access key (never commit real values).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# Optional when the production bucket requires a customer-managed KMS key.
# S3_KMS_KEY_ID=arn:aws:kms:ap-southeast-1:account-id:key/key-id
# Optional only for an intentional S3-compatible emulator.
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_USE_PATH_STYLE_ENDPOINT=true

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI Configuration
GROQ_API_KEY=your_groq_api_key_here

# Mail Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_FROM_ADDRESS=your_email@gmail.com
MAIL_FROM_NAME=GRADTRACK
FRONTEND_URL=http://localhost:5173

# Realtime Messaging
GRADTRACK_API_BASE_URL=http://localhost/GradTrack/backend
REALTIME_AUTH_CHECK_URL=http://localhost/GradTrack/backend/api/graduate-auth/check.php
REALTIME_AUTH_TIMEOUT_MS=12000
REALTIME_PORT=3001
REALTIME_HOST=127.0.0.1
REALTIME_DB_CONNECTION_LIMIT=10
REALTIME_AUTO_MIGRATE=false
REALTIME_PRESENCE_OFFLINE_GRACE_MS=1500
REALTIME_PRESENCE_RECOVERY_GRACE_MS=5000
REALTIME_PING_INTERVAL_MS=25000
REALTIME_PING_TIMEOUT_MS=20000
CHAT_AUTO_MIGRATE=false
CHAT_IMAGE_MAX_MB=10
CHAT_DOCUMENT_MAX_MB=25
UPLOAD_REQUEST_MAX_MB=256
SCHEMA_AUTO_MIGRATE=true
ALLOW_LEGACY_PLAINTEXT_PASSWORDS=true

# Production forces Secure, HttpOnly, SameSite=Lax, host-only cookies.
# SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_SAMESITE=None
# SESSION_COOKIE_DOMAIN=.your-domain.com
# SESSION_COOKIE_NAME=GRADTRACKSESSID
# SESSION_COOKIE_PATH=/

# Philippine Standard Geographic Code API
PSGC_API_BASE_URL=https://psgc.cloud/api/v2

# Automatic Survey Reminder Job
# Use 3 days by default; this can also be managed in System Settings.
SURVEY_REMINDER_INTERVAL_DAYS=3
SURVEY_REMINDER_BATCH_LIMIT=100
# The reminder entry point is CLI-only and is scheduled by systemd in production.
