# Database Configuration
# DB_HOST must be the Amazon RDS endpoint hostname only.
# Do not include http://, https://, or :3306 in DB_HOST.
DB_HOST=your-rds-endpoint.rds.amazonaws.com
DB_NAME=your_database_name
DB_USER=your_username
DB_PASSWORD=your_password
DB_PORT=3306
# Optional aliases also supported by the backend:
# DB_DATABASE=your_database_name
# DB_USERNAME=your_username

# Application Configuration
APP_ENV=production
APP_DEBUG=false

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175,http://127.0.0.1:5176,https://your-frontend-domain.com

# AI Configuration
GROQ_API_KEY=your_groq_api_key_here

# Mail Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_FROM_ADDRESS=your_email@gmail.com
MAIL_FROM_NAME=GRADTRACK
FRONTEND_URL=http://localhost:5173

# Realtime Messaging
GRADTRACK_API_BASE_URL=http://localhost/GradTrack/backend
REALTIME_AUTH_CHECK_URL=http://localhost/GradTrack/backend/api/graduate-auth/check.php
REALTIME_PORT=3001
REALTIME_DB_CONNECTION_LIMIT=10
REALTIME_AUTO_MIGRATE=false
REALTIME_PRESENCE_OFFLINE_GRACE_MS=1500
REALTIME_PRESENCE_RECOVERY_GRACE_MS=5000
REALTIME_PING_INTERVAL_MS=25000
REALTIME_PING_TIMEOUT_MS=20000
CHAT_AUTO_MIGRATE=false
CHAT_IMAGE_MAX_MB=10
CHAT_DOCUMENT_MAX_MB=25

# Required when the frontend and API use different HTTPS sites.
# SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_SAMESITE=None
# SESSION_COOKIE_DOMAIN=.your-domain.com

# Philippine Standard Geographic Code API
PSGC_API_BASE_URL=https://psgc.cloud/api/v2

# Automatic Survey Reminder Job
# Use 3 days by default; this can also be managed in System Settings.
SURVEY_REMINDER_INTERVAL_DAYS=3
SURVEY_REMINDER_BATCH_LIMIT=100
# Required only when calling backend/api/surveys/auto-reminders.php over HTTP.
# PHP CLI runs do not need this secret.
SURVEY_REMINDER_CRON_SECRET=change_this_long_random_secret
