        <mxCell id="process-heading" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=17;fontStyle=1;fontFamily=Arial;fontColor=#111827;" value="PROCESS" vertex="1">
          <mxGeometry height="28" width="260" x="420" y="163" as="geometry" />
        </mxCell>
        <mxCell id="output-heading" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=17;fontStyle=1;fontFamily=Arial;fontColor=#111827;" value="OUTPUT" vertex="1">
          <mxGeometry height="28" width="260" x="770" y="163" as="geometry" />
        </mxCell>
        <mxCell id="input-body" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=13;fontFamily=Arial;fontColor=#111827;spacingLeft=4;spacingRight=4;spacingTop=0;" value="• Registrar graduate records&lt;div&gt;&lt;br&gt;• Graduate identity, account, profile, and verification data&lt;/div&gt;&lt;div&gt;&lt;br&gt;• Tracer survey responses: personal, education, training, employment, address&lt;/div&gt;&lt;div&gt;&lt;br&gt;• Alumni registry imports and account review decisions&lt;/div&gt;&lt;div&gt;&lt;br&gt;• Forum posts, comments, reactions, reports, and chat messages&lt;/div&gt;&lt;div&gt;&lt;br&gt;• Job post details and application links&lt;/div&gt;&lt;div&gt;&lt;br&gt;• Admin users, settings, reminders, and report filters&lt;/div&gt;" vertex="1">
          <mxGeometry height="330" width="248" x="76" y="205" as="geometry" />
        </mxCell>
        <mxCell id="process-body" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=13;fontFamily=Arial;fontColor=#111827;spacingLeft=4;spacingRight=4;spacingTop=0;" value="• Role-based authentication, sessions, and feature access control&lt;div&gt;&lt;br&gt;• Registrar graduate record management&lt;/div&gt;&lt;div&gt;&lt;br&gt;• Graduate verification, survey tokens, validation, and response storage&lt;/div&gt;&lt;div&gt;&lt;br&gt;• Graduate account registration and alumni verification&lt;/div&gt;&lt;div&gt;&lt;br&gt;• Forum moderation, activity logging, reactions, and realtime messaging&lt;/div&gt;&lt;div&gt;&lt;br&gt;• Job-post eligibility checking, submission, link validation, and approval&lt;/div&gt;&lt;div&gt;&lt;br&gt;• Analytics, reports, exports, reminders, audit trail, backup, and GenAI explanation&lt;/div&gt;" vertex="1">
          <mxGeometry height="330" width="248" x="426" y="205" as="geometry" />
        </mxCell>
        <mxCell id="output-body" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=13;fontFamily=Arial;fontColor=#111827;spacingLeft=4;spacingRight=4;spacingTop=0;" value="• Graduate portal account statuses&lt;div&gt;&lt;br&gt;• Graduate profiles with work, education, training, posts, and activity&lt;/div&gt;&lt;div&gt;&lt;br&gt;• Stored tracer responses and participation status lists&lt;/div&gt;&lt;div&gt;&lt;br&gt;• Employment, alignment, salary, location, program, and cohort statistics&lt;/div&gt;&lt;div&gt;&lt;br&gt;• Dashboards, charts, report tables, descriptive analytics, and GenAI explanations&lt;/div&gt;&lt;div&gt;&lt;br&gt;• PDF/Excel reports, CSV registry exports, and database backups&lt;/div&gt;&lt;div&gt;&lt;br&gt;• Approved jobs, moderated forum interactions, conversations, and notifications&lt;/div&gt;" vertex="1">
          <mxGeometry height="330" width="248" x="776" y="205" as="geometry" />
        </mxCell>
