{
  "name": "gradtrack",
  "version": "1.0.0",
  "description": "Graduate tracking and survey management system",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.js",
    "install:frontend": "cd frontend && npm install",
    "install:backend": "cd backend && composer install",
    "install:all": "npm run install:frontend && npm run install:backend",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && php -S localhost:8000",
    "dev:realtime": "node backend/realtime/socket-server.js",
    "test:realtime": "node backend/tests/realtime_messaging_integration.js",
    "test:realtime-portal": "node backend/tests/realtime_portal_integration.js",
    "test:auth-isolation": "php backend/tests/auth_session_isolation_integration.php",
    "test:message-split": "php backend/tests/chat_message_split_integration.php",
    "test:message-unread": "php backend/tests/chat_unread_state_integration.php",
    "test:direct-first-message": "php backend/tests/direct_message_first_send_integration.php",
    "test:conversation-info": "php backend/tests/conversation_information_integration.php",
    "test:conversation-info-http": "php backend/tests/conversation_information_http_integration.php",
    "test:job-notifications": "php backend/tests/job_notification_read_state_integration.php",
    "test:profile-avatars": "php backend/tests/profile_avatar_consistency_integration.php",
    "test:genai-data-tools": "php backend/tests/genai_data_tools_test.php",
    "test:genai-role-behavior": "php backend/tests/genai_role_scope_test.php && php backend/tests/genai_role_behavior_test.php",
    "test:genai-history": "php backend/tests/genai_conversation_history_integration.php",
    "test:genai-live": "php backend/tests/genai_live_data_http_integration.php",
    "test:genai-four-roles": "php backend/tests/genai_four_role_http_integration.php",
    "test:mini-profile": "php backend/tests/mini_profile_http_integration.php",
    "test:dean-reports": "php backend/tests/dean_reports_scope_integration.php",
    "test:inferential": "php backend/tests/inferential_analysis_test.php && php backend/tests/inferential_analysis_integration.php",
    "test:inferential-http": "php backend/tests/inferential_analysis_http_integration.php",
    "test:graduate-portal": "php backend/tests/graduate_profile_isolation_integration.php && php backend/tests/graduate_portal_access_integration.php",
    "test:active-survey-years": "php backend/tests/active_survey_graduation_year_coverage_integration.php && cd frontend && npm run test:active-survey-years",
    "test:survey-validation": "php backend/tests/survey_validation_rules_test.php && php backend/tests/psgc_cache_test.php && cd frontend && npm run test:survey-validation",
    "build:frontend": "cd frontend && npm run build",
    "deploy:backend": "cd backend && eb deploy",
    "deploy:frontend": "cd frontend && amplify publish",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f"
  },
  "keywords": [
    "graduate-tracking",
    "survey",
    "education"
  ],
  "author": "GradTrack Team",
  "license": "UNLICENSED",
  "dependencies": {
    "dotenv": "^17.4.2",
    "mysql2": "^3.23.2",
    "socket.io": "^4.8.3"
  }
}
