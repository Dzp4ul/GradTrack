# Environment variables
.env
.env.local
*.env.local

# Dependencies
node_modules/
frontend/node_modules/
backend/vendor/

# Database files - keep schema, ignore dumps
database/*_dump.sql
database/backup_*.sql

# Documentation temp files
*.md~

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# Runtime PSGC last-known-good cache
backend/api/address/data/*.json

# Runtime uploads and migration manifests (existing tracked legacy files remain preserved)
backend/uploads/**
!backend/uploads/.gitkeep
backend/tmp/*.json

# Build and deployment artifacts
dist/
frontend/dist/
deploy/aws/*.rendered

# Elastic Beanstalk
.elasticbeanstalk/

# Amplify
.amplify/
amplify/

# Docker
.docker/
